.field {
  padding-bottom: 28rpx;
  margin-bottom: 28rpx;
  border-bottom: 1rpx solid #f0f1f3;
}

.field-last {
  padding-bottom: 0;
  margin-bottom: 0;
  border-bottom: none;
}

.label {
  display: block;
  font-size: 26rpx;
  color: var(--text-sub);
  margin-bottom: 14rpx;
}

.req {
  color: #e54545;
}

.input {
  height: 72rpx;
  font-size: 30rpx;
  line-height: 72rpx;
}

.picker {
  color: var(--text);
}

.ph {
  color: #b8bcc4;
}

.textarea {
  width: 100%;
  height: 200rpx;
  font-size: 30rpx;
  line-height: 44rpx;
  box-sizing: border-box;
}

.submit {
  height: 92rpx;
  line-height: 92rpx;
  text-align: center;
  font-size: 32rpx;
  color: #fff;
  background: var(--primary);
  border-radius: 100rpx;
  margin-top: 8rpx;
}

.submit-disabled {
  opacity: 0.6;
}
